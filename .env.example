# ============================================
# APPLICATION CORE
# ============================================

# Application name used in UI elements and notifications
APP_NAME=Laravel

# Application environment: local, staging, production
APP_ENV=local

# Application encryption key - Generate with: php artisan key:generate
# CRITICAL: Keep this secret and never commit actual keys
APP_KEY=

# Debug mode - Shows detailed error messages
# WARNING: MUST be false in production
APP_DEBUG=true

# Base URL of the application
APP_URL=http://localhost

# Application locale for translations
APP_LOCALE=en

# Fallback locale when translation missing
APP_FALLBACK_LOCALE=en

# Locale for Faker data generation (development)
APP_FAKER_LOCALE=en_US

# Maintenance mode storage driver: file, cache
APP_MAINTENANCE_DRIVER=file

# Cache store for maintenance mode (when driver=cache)
# APP_MAINTENANCE_STORE=database

# Previous encryption keys for key rotation (comma-separated)
# APP_PREVIOUS_KEYS=

# Number of PHP CLI server workers
PHP_CLI_SERVER_WORKERS=4

# BCrypt hashing cost factor (higher = more secure, slower)
BCRYPT_ROUNDS=12

# Vite build configuration
VITE_APP_NAME="${APP_NAME}"


# ============================================
# LOGGING
# ============================================

# Default log channel: stack, single, daily, slack, syslog, errorlog
LOG_CHANNEL=stack

# Log channels to include in stack (comma-separated)
LOG_STACK=single

# Channel for deprecation warnings
LOG_DEPRECATIONS_CHANNEL=null

# Minimum log level: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug


# ============================================
# ERROR TRACKING & MONITORING (SENTRY)
# ============================================

# Sentry Data Source Name (DSN) for error tracking
# Get from: https://sentry.io/settings/projects/
SENTRY_LARAVEL_DSN=

# Application version for release tracking
# Set to git hash or semantic version
APP_VERSION=1.0.0

# Percentage of transactions to send to Sentry (0.0-1.0)
SENTRY_TRACES_SAMPLE_RATE=0.2

# Percentage of transactions to profile (0.0-1.0)
SENTRY_PROFILES_SAMPLE_RATE=0.2

# Enable logs to be sent to Sentry
SENTRY_ENABLE_LOGS=true


# ============================================
# DATABASE CONFIGURATION
# ============================================

# Default database connection: sqlite, mysql, pgsql, sqlsrv
# NOTE: Use pgsql for production (required for pgvector)
DB_CONNECTION=sqlite

# Database connection URL (alternative to individual params)
# DB_URL=

# Database server hostname
# DB_HOST=127.0.0.1

# Database server port (3306 for MySQL, 5432 for PostgreSQL)
# DB_PORT=5432

# Database name
# DB_DATABASE=laravel

# Database username
# DB_USERNAME=root

# Database password
# DB_PASSWORD=

# Database character set
# DB_CHARSET=utf8

# Database collation (MySQL only)
# DB_COLLATION=utf8mb4_unicode_ci

# Enable foreign key constraints (SQLite)
# DB_FOREIGN_KEYS=true

# MySQL Unix socket path
# DB_SOCKET=

# MySQL SSL certificate authority path
# MYSQL_ATTR_SSL_CA=

# Database connection for cache storage
# DB_CACHE_CONNECTION=

# Database table name for cache storage
# DB_CACHE_TABLE=cache

# Database connection for cache locks
# DB_CACHE_LOCK_CONNECTION=

# Database table name for cache locks
# DB_CACHE_LOCK_TABLE=

# Database connection for queue storage
# DB_QUEUE_CONNECTION=

# Database table name for queue jobs
# DB_QUEUE_TABLE=jobs

# Default queue name for database driver
# DB_QUEUE=default

# Seconds before retrying failed database queue jobs
# DB_QUEUE_RETRY_AFTER=90

# Full database URL for PostgreSQL (used by MCP servers)
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname


# ============================================
# NEO4J GRAPH DATABASE
# ============================================

# Master switch to enable Neo4j integration

# Neo4j connection type: bolt, http
NEO4J_CONNECTION=bolt

# Full Neo4j connection URI

# Neo4j server hostname

# Neo4j Bolt protocol port

# Neo4j HTTP API port
NEO4J_HTTP_PORT=7474

# Neo4j username (legacy, use NEO4J_USERNAME)

# Neo4j authentication username
NEO4J_USERNAME=neo4j

# Neo4j authentication password
# CRITICAL: Change default password immediately

# Neo4j database name (4.x+)

# Minimum similarity score for creating graph relationships (0.70-1.0)
NEO4J_SIMILARITY_THRESHOLD=0.85

# Number of records to sync per batch
NEO4J_SYNC_BATCH_SIZE=100

# Enable automatic sync from relational DB to graph DB
NEO4J_AUTO_SYNC=true

# Automatically sync to graph on document ingest
NEO4J_AUTO_SYNC_ON_INGEST=true

# Update existing relationships during sync
NEO4J_UPDATE_RELATIONSHIPS=true


# ============================================
# OPENAI API
# ============================================

# OpenAI API authentication key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI organization ID (optional)
OPENAI_ORG=

# OpenAI project ID (optional)
OPENAI_PROJECT=

# OpenAI API base URL (override for custom endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1

# Default model for response generation
OPENAI_RESPONSES_MODEL=gpt-4.1-mini

# Default model for chat completions
OPENAI_CHAT_MODEL=gpt-4o-mini

# Default model for embeddings generation
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Default model for image generation
OPENAI_IMAGE_MODEL=gpt-image-1

# Default model for speech-to-text
OPENAI_STT_MODEL=whisper-1

# Default model for text-to-speech
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# HTTP request timeout in seconds
OPENAI_TIMEOUT=60

# HTTP connection timeout in seconds
OPENAI_CONNECT_TIMEOUT=10

# Number of retry attempts for failed requests
OPENAI_RETRY_TIMES=2

# Milliseconds to wait between retries
OPENAI_RETRY_SLEEP_MS=200


# ============================================
# OTHER LLM PROVIDER API KEYS
# ============================================

# Anthropic (Claude) API key
# Get from: https://console.anthropic.com/
# Required for sudska-praksa:generate-keywords command
ANTHROPIC_API_KEY=

# Google Gemini API key
# Get from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=

# DeepSeek AI API key
# DEEPSEEK_API_KEY=

# Mistral AI API key
# MISTRAL_API_KEY=

# Groq API key (fast inference)
# Get from: https://console.groq.com/
# GROQ_API_KEY=

# xAI (Grok) API key
# XAI_API_KEY=

# Voyage AI API key (embeddings)
# VOYAGEAI_API_KEY=

# OpenRouter API key (access 100+ models)
# Get from: https://openrouter.ai/settings
# OPENROUTER_API_KEY=

# HTTP Referer header for OpenRouter requests
# OPENROUTER_HTTP_REFERER=

# Application name for OpenRouter requests
# OPENROUTER_APP_NAME=


# ============================================
# AWS SERVICES
# ============================================

# AWS IAM access key ID
# Required for S3 and Textract
AWS_ACCESS_KEY_ID=

# AWS IAM secret access key
# CRITICAL: Never commit this to version control
AWS_SECRET_ACCESS_KEY=

# AWS region for services
AWS_DEFAULT_REGION=us-east-1

# S3 bucket name for file storage
AWS_BUCKET=

# Custom S3 endpoint URL
AWS_URL=

# Custom AWS endpoint (for S3-compatible services like MinIO)
AWS_ENDPOINT=

# Use path-style S3 URLs instead of virtual-hosted-style
# Set to true for MinIO, false for AWS S3
AWS_USE_PATH_STYLE_ENDPOINT=false

# S3 prefix for Textract input documents
S3_INPUT_PREFIX=textract/input

# S3 prefix for Textract output results
S3_OUTPUT_PREFIX=textract/output

# S3 prefix for Textract JSON results
S3_JSON_PREFIX=textract/json

# S3 prefix for extracted table data
S3_TABLES_PREFIX=textract/tables


# ============================================
# GOOGLE DRIVE INTEGRATION
# ============================================

# Absolute path to Google service account JSON file
# Service account must have Drive API enabled
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Google Drive folder ID for document storage
# Get from folder URL in Drive
GOOGLE_DRIVE_FOLDER_ID=

# Email address to impersonate for domain-wide delegation
GOOGLE_IMPERSONATE_USER=


# ============================================
# TEXTRACT OCR PROCESSING
# ============================================

# Auto-sync Textract content changes
TEXTRACT_AUTO_SYNC=true

# Embedding model for Textract content
TEXTRACT_EMBEDDING_MODEL=text-embedding-3-small

# Embedding provider: openai, cohere
TEXTRACT_EMBEDDING_PROVIDER=openai

# Batch size for embedding generation
TEXTRACT_EMBEDDING_BATCH_SIZE=100

# Maximum retries for failed embedding requests
TEXTRACT_EMBEDDING_MAX_RETRIES=3

# Target chunk size in characters (~1000 chars ≈ 250 tokens)
TEXTRACT_CHUNK_SIZE=1000

# Overlap between chunks in characters
TEXTRACT_CHUNK_OVERLAP=200

# Queue name for Textract jobs
TEXTRACT_QUEUE=default

# Timeout for embedding jobs in seconds
TEXTRACT_EMBEDDING_TIMEOUT=600

# Timeout for graph sync jobs in seconds
TEXTRACT_GRAPH_TIMEOUT=300

# Minimum content length in characters
TEXTRACT_MIN_CONTENT_LENGTH=10

# Maximum content length in characters (10MB)
TEXTRACT_MAX_CONTENT_LENGTH=10000000

# Allow empty content (for deletion)
TEXTRACT_ALLOW_EMPTY_CONTENT=false

# Enable content editing UI
TEXTRACT_ENABLE_CONTENT_EDITING=true

# Enable manual sync triggers
TEXTRACT_ENABLE_MANUAL_SYNC=true

# Enable reset to original functionality
TEXTRACT_ENABLE_RESET_CONTENT=true

# Auto-generate embeddings after Textract completion
TEXTRACT_AUTO_EMBEDDINGS=true

# Auto-extract tables from documents
TEXTRACT_AUTO_TABLES=true


# ============================================
# VIZRA ADK FRAMEWORK
# ============================================

# Master switch to enable/disable Vizra ADK
VIZRA_ADK_ENABLED=true

# Enable logging for Vizra ADK
VIZRA_ADK_LOGGING_ENABLED=true

# Minimum log level: debug, info, warning, error, critical, none
VIZRA_ADK_LOGGING_LEVEL=warning

# Enable logging for vector memory operations
VIZRA_ADK_LOG_VECTOR_MEMORY=false

# Enable logging for agent operations
VIZRA_ADK_LOG_AGENTS=true

# Enable logging for tool executions
VIZRA_ADK_LOG_TOOLS=true

# Enable logging for MCP operations
VIZRA_ADK_LOG_MCP=true

# Enable logging for execution traces
VIZRA_ADK_LOG_TRACES=true

# Default LLM provider: openai, anthropic, google, gemini, deepseek, ollama, mistral, groq, xai, grok, voyageai, openrouter
VIZRA_ADK_DEFAULT_PROVIDER=google

# Default LLM model name
VIZRA_ADK_DEFAULT_MODEL=gemini-1.5-flash

# Default temperature for LLM generation (0.0-2.0)
# VIZRA_ADK_DEFAULT_TEMPERATURE=

# Default maximum tokens for LLM generation
# VIZRA_ADK_DEFAULT_MAX_TOKENS=

# Default top-p (nucleus sampling) for LLM generation (0.0-1.0)
# VIZRA_ADK_DEFAULT_TOP_P=

# Total timeout for LLM API calls in seconds
VIZRA_ADK_HTTP_TIMEOUT=120

# Connection timeout for LLM API calls in seconds
VIZRA_ADK_HTTP_CONNECT_TIMEOUT=10

# Maximum depth for nested sub-agent delegation
VIZRA_ADK_MAX_DELEGATION_DEPTH=5

# Enable execution tracing for debugging
VIZRA_ADK_TRACING_ENABLED=true

# Days to retain trace data before cleanup
VIZRA_ADK_TRACING_CLEANUP_DAYS=30

# Enable Vizra ADK web interface
VIZRA_ADK_WEB_ENABLED=true

# Agent name to use for GPT-4 model mapping
VIZRA_ADK_OPENAI_GPT4_AGENT=chat_agent

# Agent name to use for GPT-4 Turbo model mapping
VIZRA_ADK_OPENAI_GPT4_TURBO_AGENT=chat_agent

# Agent name to use for GPT-3.5 Turbo model mapping
VIZRA_ADK_OPENAI_GPT35_AGENT=chat_agent

# Agent name to use for GPT-4o model mapping
VIZRA_ADK_OPENAI_GPT4O_AGENT=chat_agent

# Agent name to use for GPT-4o Mini model mapping
VIZRA_ADK_OPENAI_GPT4O_MINI_AGENT=chat_agent

# Default agent when no model mapping found
VIZRA_ADK_DEFAULT_CHAT_AGENT=chat_agent

# Store prompts in database for dynamic updates
VIZRA_ADK_PROMPTS_USE_DATABASE=false

# Path for file-based prompt storage
VIZRA_ADK_PROMPTS_PATH=resources/prompts

# Track which prompt versions are used
VIZRA_ADK_PROMPTS_TRACK_USAGE=false

# Cache TTL for database prompts in seconds (0 = disabled)
VIZRA_ADK_PROMPTS_CACHE_TTL=300

# Default prompt version: latest, default, or specific version
VIZRA_ADK_PROMPTS_DEFAULT_VERSION=default

# Minimum OCR confidence score (0.0-1.0)
VIZRA_ADK_OCR_MIN_CONFIDENCE=0.82

# Minimum text coverage percentage (0.0-1.0)
VIZRA_ADK_OCR_MIN_COVERAGE=0.75

# Maximum pages with low confidence before flagging
VIZRA_ADK_OCR_MAX_LOW_CONF_PAGES=3

# Skip embedding when OCR quality is below threshold
VIZRA_ADK_OCR_SKIP_EMBEDDING_ON_LOW_QUALITY=false

# OCR Pipeline Configuration (ocrmypdf)
OCR_DEFAULT_ENGINE=auto
OCRMYPDF_BINARY=ocrmypdf
OCRMYPDF_LANGUAGES=hrv+eng
OCRMYPDF_TIMEOUT=600
OCRMYPDF_DESKEW=true
OCRMYPDF_CLEAN=false
OCR_FORCE_REOCR_ON_REVIEW=true

# Enable vector memory functionality
VIZRA_ADK_VECTOR_ENABLED=true

# Vector storage driver: pgvector, meilisearch
VIZRA_ADK_VECTOR_DRIVER=pgvector

# Embedding provider: openai, cohere, ollama, gemini
VIZRA_ADK_EMBEDDING_PROVIDER=openai

# OpenAI embedding model name
VIZRA_ADK_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cohere embedding model name
VIZRA_ADK_COHERE_EMBEDDING_MODEL=embed-english-v3.0

# Ollama embedding model name
VIZRA_ADK_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Gemini embedding model name
VIZRA_ADK_GEMINI_EMBEDDING_MODEL=text-embedding-004

# PostgreSQL connection name for pgvector
VIZRA_ADK_PGVECTOR_CONNECTION=pgsql

# Text chunking strategy: sentence, paragraph
VIZRA_ADK_CHUNK_STRATEGY=sentence

# Characters per chunk
VIZRA_ADK_CHUNK_SIZE=1000

# Overlap between chunks in characters
VIZRA_ADK_CHUNK_OVERLAP=200

# Maximum context length for RAG in characters
VIZRA_ADK_RAG_MAX_CONTEXT=4000

# Include metadata in RAG context
VIZRA_ADK_RAG_INCLUDE_METADATA=true


# ============================================
# AGENT FRAMEWORK
# ============================================

# Maximum iterations per research run
AGENT_MAX_ITERATIONS=10

# Time limit in seconds for agent execution (600 = 10 minutes)
AGENT_TIME_LIMIT=600

# Quality threshold for evaluation (0-1)
AGENT_THRESHOLD=0.75

# Maximum tokens per run (null = unlimited)
# AGENT_TOKEN_BUDGET=

# Maximum cost in USD per run (null = unlimited)
# AGENT_COST_BUDGET=

# Scheduled research frequency: daily, weekly, monthly
AGENT_SCHEDULE_CRON=weekly

# Day of week for scheduled runs (0-6, 0=Sunday)
AGENT_SCHEDULE_DAY=0

# Time of day for scheduled runs (24-hour format)
AGENT_SCHEDULE_TIME=02:00

# Enable async execution via jobs
AGENT_ASYNC_EXECUTION=false

# Cache vector search results
AGENT_CACHE_ENABLED=true

# Cache TTL in seconds (3600 = 1 hour)
AGENT_CACHE_TTL=3600

# Queue name for agent jobs
AGENT_QUEUE=agents

# Queue connection for agent jobs (uses default if not set)
# AGENT_QUEUE_CONNECTION=

# Log level for agent operations: debug, info, warning, error
AGENT_LOG_LEVEL=info

# Log channel for agent operations
AGENT_LOG_CHANNEL=stack

# Enable detailed iteration logging
AGENT_LOG_ITERATIONS=true

# Enable action result logging
AGENT_LOG_ACTIONS=true

# Maximum allowed cost per run (safety limit in USD)
AGENT_MAX_COST=5.00

# Maximum allowed time per run (safety limit in seconds, 3600 = 1 hour)
AGENT_MAX_TIME=3600

# Maximum concurrent agent runs
AGENT_MAX_CONCURRENT=5

# Require approval for runs exceeding limits
AGENT_REQUIRE_APPROVAL=false


# ============================================
# MCP (MODEL CONTEXT PROTOCOL)
# ============================================

# API token for MCP endpoint authentication
# Generate secure random token for production
MCP_API_TOKEN=

# Rate limit format (max_attempts:decay_minutes)
MCP_RATE_LIMIT=60:1

# Enable MCP authentication
MCP_AUTH_ENABLED=true

# HTTP header name for MCP token
MCP_TOKEN_HEADER=X-MCP-Token

# Enable rate limiting for MCP endpoints
MCP_RATE_LIMIT_ENABLED=true

# Default requests per minute limit
MCP_RATE_LIMIT_PER_MINUTE=60

# Default requests per hour limit
MCP_RATE_LIMIT_PER_HOUR=1000

# Rate limit for law.search tool (per minute)
MCP_RATE_LAW_SEARCH=30

# Rate limit for law.get_article tool (per minute)
MCP_RATE_LAW_GET=60

# Rate limit for decision.search tool (per minute)
MCP_RATE_DECISION_SEARCH=30

# Rate limit for decision.get tool (per minute)
MCP_RATE_DECISION_GET=60

# Rate limit for case.search tool (per minute)
MCP_RATE_CASE_SEARCH=20

# Maximum page size for MCP responses
MCP_MAX_PAGE_SIZE=100

# Default page size for MCP responses
MCP_DEFAULT_PAGE_SIZE=10

# Signed URL expiry time in seconds (3600 = 1 hour)
MCP_SIGNED_URL_EXPIRY=3600

# Path to npx executable for MCP servers
MCP_NPX_PATH=npx

# Base path for filesystem MCP server
MCP_FILESYSTEM_PATH=/app

# Enable filesystem MCP server
MCP_FILESYSTEM_ENABLED=false

# Enable GitHub MCP server
MCP_GITHUB_ENABLED=false

# GitHub personal access token for MCP server
GITHUB_TOKEN=

# URL for GitHub HTTP MCP server
MCP_GITHUB_HTTP_URL=http://localhost:8001/api/mcp

# API key for GitHub HTTP MCP server
MCP_GITHUB_HTTP_API_KEY=

# Enable GitHub HTTP MCP server
MCP_GITHUB_HTTP_ENABLED=false

# PostgreSQL connection URL for MCP server
MCP_POSTGRES_URL=

# Enable PostgreSQL MCP server
MCP_POSTGRES_ENABLED=false

# Brave Search API key for MCP server
BRAVE_API_KEY=

# Enable Brave Search MCP server
MCP_BRAVE_SEARCH_ENABLED=false

# Slack bot token for MCP server
SLACK_BOT_TOKEN=

# Enable Slack MCP server
MCP_SLACK_ENABLED=false

# URL for Odluke MCP server (court decisions)
MCP_ODLUKE_URL=

# Enable Odluke MCP server
MCP_ODLUKE_ENABLED=true

# Timeout for Odluke MCP server in seconds
MCP_ODLUKE_TIMEOUT=45


# ============================================
# EXTERNAL APIS - CROATIAN COURT SYSTEMS
# ============================================

# Base URL for e-Komunikacija court system
EKOM_BASE_URL=https://e-komunikacija.pravosudje.hr

# Authentication token for EKOM API
EKOM_TOKEN=

# Request timeout for EKOM API in seconds
EKOM_TIMEOUT=30

# Number of retry attempts for failed EKOM requests
EKOM_RETRIES=2

# Delay between EKOM retries in milliseconds
EKOM_RETRY_DELAY_MS=300

# User agent string for EKOM requests
EKOM_USER_AGENT=Laravel-Ekom-Client/1.0

# Default page size for EKOM API pagination (max 100)
EKOM_DEFAULT_PAGE_SIZE=50

# Base URL for e-Oglasna court notices system
E_OGLASNA_BASE_URL=https://e-oglasna.pravosudje.hr

# Request timeout for e-Oglasna in seconds
E_OGLASNA_TIMEOUT=15

# Connection timeout for e-Oglasna in seconds
E_OGLASNA_CONNECT_TIMEOUT=10

# Minimum delay between e-Oglasna requests in milliseconds (~1 req/sec)
E_OGLASNA_MIN_DELAY_MS=1100

# Maximum requests per hour for e-Oglasna (stay under 1000/hour limit)
E_OGLASNA_MAX_REQUESTS_PER_HOUR=950

# Jitter added to retry backoff in milliseconds
E_OGLASNA_RETRY_JITTER_MS=100

# Maximum pages per deep scan for safety
E_OGLASNA_DEEP_SCAN_MAX_PAGES=500

# Default sort order for e-Oglasna results
E_OGLASNA_DEFAULT_SORT=datePublished,desc

# Base URL for Odluke court decisions system
ODLUKE_BASE_URL=https://odluke.sudovi.hr

# Request timeout for Odluke in seconds
ODLUKE_TIMEOUT=30

# Number of retry attempts for Odluke
ODLUKE_RETRY=2

# Delay between Odluke requests in milliseconds
ODLUKE_DELAY_MS=700

# Maximum requests per minute for Odluke
ODLUKE_RPM=30

# Extra backoff on 429/5xx errors in milliseconds
ODLUKE_BACKOFF_MS=800

# Enable automatic graph sync during court decision ingestion
ODLUKE_SYNC_GRAPH=true


# ============================================
# SUDSKA PRAKSA SEARCH
# ============================================

# Base URL for Sudska Praksa keyword search
SUDSKA_PRAKSA_BASE_URL=https://odluke.sudovi.hr/Document/DisplayList

# Default court types for search (comma-separated)
# vks=Vrhovni kazneni sud, vps=Visoki prekrsajni sud, vs=Vrhovni sud, zs=Zupanijski sudovi
SUDSKA_PRAKSA_COURTS=vks,vps,vs,zs

# Delay between requests in milliseconds
SUDSKA_PRAKSA_DELAY=500

# Request timeout in seconds
SUDSKA_PRAKSA_TIMEOUT=15


# ============================================
# GRAPHQL CLIENT
# ============================================

# GraphQL API endpoint URL
GRAPHQL_ENDPOINT=

# HTTP header name for GraphQL authentication
GRAPHQL_AUTH_HEADER=Authorization

# Bearer token for GraphQL authentication
GRAPHQL_TOKEN=

# Cache store for GraphQL queries: file, redis, database
GRAPHQL_CACHE_STORE=file

# Auto-discover GraphQL schema via introspection
GRAPHQL_AUTO_DISCOVER=true


# ============================================
# CACHE CONFIGURATION
# ============================================

# Default cache store driver: redis, database, file, memcached, dynamodb
CACHE_STORE=database

# Cache key prefix to avoid collisions
# CACHE_PREFIX=

# Redis connection for cache
REDIS_CACHE_CONNECTION=cache

# Redis connection for cache locks
REDIS_CACHE_LOCK_CONNECTION=default

# DynamoDB table name for cache
# DYNAMODB_CACHE_TABLE=cache

# Custom DynamoDB endpoint
# DYNAMODB_ENDPOINT=


# ============================================
# QUEUE CONFIGURATION
# ============================================

# Default queue connection driver: redis, database, sqs, sync
# NOTE: Use 'redis' with Horizon (required for Horizon to function)
QUEUE_CONNECTION=redis

# Redis queue key prefix
QUEUE_PREFIX=queues

# Failed job storage driver: database-uuids, dynamodb, file
QUEUE_FAILED_DRIVER=database-uuids

# Redis connection for queue
REDIS_QUEUE_CONNECTION=default

# Default Redis queue name
REDIS_QUEUE=default

# Seconds before retrying failed Redis queue jobs
REDIS_QUEUE_RETRY_AFTER=90

# Beanstalkd server hostname
# BEANSTALKD_QUEUE_HOST=localhost

# Default Beanstalkd queue tube
# BEANSTALKD_QUEUE=default

# Seconds before retrying failed Beanstalkd jobs
# BEANSTALKD_QUEUE_RETRY_AFTER=90

# AWS SQS queue URL prefix
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id

# Default SQS queue name
# SQS_QUEUE=default

# SQS queue name suffix (e.g., .fifo)
# SQS_SUFFIX=


# ============================================
# DISTRIBUTED PROCESSING
# ============================================

# Enable auto-scaling for workers
DISTRIBUTED_SCALING_ENABLED=false

# Default embedding model for distributed processing
EMBEDDING_MODEL=text-embedding-3-small


# ============================================
# REDIS CONFIGURATION
# ============================================

# Redis client library: phpredis, predis
REDIS_CLIENT=phpredis

# Redis server hostname
REDIS_HOST=127.0.0.1

# Redis server password
REDIS_PASSWORD=null

# Redis server port
REDIS_PORT=6379

# Redis database number for default connection
REDIS_DB=0

# Redis database number for cache
REDIS_CACHE_DB=1

# Full Redis connection URL
# REDIS_URL=

# Redis username (Redis 6+)
# REDIS_USERNAME=

# Redis cluster mode: redis, cluster
# REDIS_CLUSTER=redis

# Redis key prefix
# REDIS_PREFIX=

# Use persistent Redis connections
# REDIS_PERSISTENT=false

# Maximum connection retry attempts
# REDIS_MAX_RETRIES=3

# Backoff algorithm for retries: decorrelated_jitter, exponential
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter

# Base backoff time in milliseconds
# REDIS_BACKOFF_BASE=100

# Maximum backoff time in milliseconds
# REDIS_BACKOFF_CAP=1000


# ============================================
# MAIL CONFIGURATION
# ============================================

# Default mail driver: smtp, sendmail, mailgun, postmark, ses, log
MAIL_MAILER=log

# Mail transport scheme: tls, ssl
MAIL_SCHEME=null

# Full mail server URL
# MAIL_URL=

# SMTP server hostname
MAIL_HOST=127.0.0.1

# SMTP server port (587=TLS, 465=SSL, 25=unencrypted)
MAIL_PORT=2525

# SMTP authentication username
MAIL_USERNAME=null

# SMTP authentication password
MAIL_PASSWORD=null

# Default "from" email address
MAIL_FROM_ADDRESS="hello@example.com"

# Default "from" name
MAIL_FROM_NAME="${APP_NAME}"

# SMTP EHLO domain
# MAIL_EHLO_DOMAIN=

# Path to sendmail binary
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i

# Log channel for mail driver
# MAIL_LOG_CHANNEL=

# Postmark API token
# POSTMARK_TOKEN=

# Resend API key
# RESEND_KEY=


# ============================================
# SESSION & BROADCASTING
# ============================================

# Session storage driver: file, cookie, database, redis
SESSION_DRIVER=database

# Session lifetime in minutes
SESSION_LIFETIME=120

# Encrypt session data
SESSION_ENCRYPT=false

# Cookie path for sessions
SESSION_PATH=/

# Cookie domain for sessions
SESSION_DOMAIN=null

# Broadcasting driver: reverb, pusher, redis, log
BROADCAST_CONNECTION=reverb

# Laravel Reverb WebSocket Server
REVERB_APP_ID=ai-legal-war-machine
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Default filesystem disk: local, public, s3
FILESYSTEM_DISK=local


# ============================================
# MEMCACHED CONFIGURATION
# ============================================

# Memcached server hostname
MEMCACHED_HOST=127.0.0.1

# Memcached server port
# MEMCACHED_PORT=11211

# Memcached SASL username
# MEMCACHED_USERNAME=

# Memcached SASL password
# MEMCACHED_PASSWORD=

# Memcached persistent connection ID
# MEMCACHED_PERSISTENT_ID=


# ============================================
# MEILISEARCH CONFIGURATION
# ============================================

# Meilisearch server URL
# MEILISEARCH_HOST=http://localhost:7700

# Meilisearch API key
# MEILISEARCH_KEY=

# Meilisearch index prefix
# MEILISEARCH_PREFIX=agent_vectors_

# Meilisearch embedder name
# MEILISEARCH_EMBEDDER=default

# Semantic vs keyword search ratio (0.0-1.0)
# MEILISEARCH_SEMANTIC_RATIO=1.0


# ============================================
# SLACK INTEGRATION
# ============================================

# Slack bot OAuth token for notifications
# SLACK_BOT_USER_OAUTH_TOKEN=

# Default Slack channel for notifications
# SLACK_BOT_USER_DEFAULT_CHANNEL=


# ============================================
# THIRD-PARTY SERVICES
# ============================================

# Postmark API token
# POSTMARK_TOKEN=

# Resend API key
# RESEND_KEY=

# TEXTRACT_EMBEDDING_MODEL=text-embedding-3-small
# TEXTRACT_EMBEDDING_PROVIDER=openai
# TEXTRACT_EMBEDDING_BATCH_SIZE=100
# TEXTRACT_EMBEDDING_MAX_RETRIES=3
# TEXTRACT_CHUNK_SIZE=1000
# TEXTRACT_CHUNK_OVERLAP=200
# TEXTRACT_QUEUE=default
# TEXTRACT_EMBEDDING_TIMEOUT=600
# TEXTRACT_GRAPH_TIMEOUT=300
# TEXTRACT_MIN_CONTENT_LENGTH=10
# TEXTRACT_MAX_CONTENT_LENGTH=10000000
# TEXTRACT_ALLOW_EMPTY_CONTENT=false
# TEXTRACT_ENABLE_CONTENT_EDITING=true
# TEXTRACT_ENABLE_MANUAL_SYNC=true
# TEXTRACT_ENABLE_RESET_CONTENT=true

# Distributed Processing Configuration
# TEXTRACT_AUTO_EMBEDDINGS=true
# TEXTRACT_AUTO_TABLES=true
# DISTRIBUTED_SCALING_ENABLED=false
# EMBEDDING_MODEL=text-embedding-3-small

# Neo4j Graph Database Configuration
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ============================================
# TESTING & SEEDING
# ============================================

# Download real court decisions from Odluke API when seeding test data
# WARNING: This is SLOW (20-50 minutes for 100 decisions)
TEST_DOWNLOAD_DECISIONS=false

# Number of court decisions to download (default: 100)
TEST_COURT_DECISION_COUNT=100

# Search query for court decisions (e.g., 'kazneni', 'građanski', 'trgovački')
# Leave empty to download all types
TEST_COURT_DECISION_QUERY=

# Additional search parameters (e.g., DateFrom=2023-01-01&DateTo=2023-12-31)
TEST_COURT_DECISION_PARAMS=

# Batch size for API requests (default: 20)
# Larger batches reduce API calls but may hit rate limits
TEST_COURT_DECISION_BATCH_SIZE=20


# ============================================
# VECTOR STORE CONFIGURATION
# ============================================

# Vector Store ID for case files (KP-DO-731, Pp Prz-74)
VS_CASE_FILES=vs_68c89c6bb90081918cf07e4441f58ecc

# Vector Store ID for Croatian laws (Zakoni clanci)
VS_LAWS=vs_68c89c812d408191add94d47a2b749e8

# Default Vector Store ID when none is specified
VS_DEFAULT=vs_68c89c6bb90081918cf07e4441f58ecc

# Directory for storing generated catalog JSON files
# Leave empty to use storage_path('app/catalog')
CATALOG_DIR=

