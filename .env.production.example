# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
#
# This is a production-safe template for .env configuration.
# All sensitive values are empty and MUST be set before deployment.
#
# CRITICAL SECURITY REQUIREMENTS:
# 1. Set ALL empty variables marked as REQUIRED
# 2. Generate strong random passwords (32+ characters)
# 3. Never commit actual production values to version control
# 4. Use secure secret management (AWS Secrets Manager, Vault, etc.)
# 5. Rotate credentials regularly
# 6. Enable all security features (HTTPS, secure cookies, etc.)
#
# ============================================

# ============================================
# APPLICATION CORE
# ============================================

# Application name
APP_NAME="AI Legal War Machine"

# Environment - MUST be "production"
APP_ENV=production

# Application encryption key
# REQUIRED: Generate with: php artisan key:generate
# CRITICAL: Keep this secret and backup securely
APP_KEY=

# Debug mode - MUST be false in production
# SECURITY: Never enable in production
APP_DEBUG=false

# Base URL - Set to your production domain
# REQUIRED: Must use HTTPS
APP_URL=https://your-domain.com

# Application locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Maintenance mode driver
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# BCrypt rounds - Higher is more secure but slower
BCRYPT_ROUNDS=12

# Vite configuration
VITE_APP_NAME="${APP_NAME}"


# ============================================
# LOGGING
# ============================================

# Log channel - Use "stack" for multiple channels
LOG_CHANNEL=stack

# Log stack - Combine multiple log channels
LOG_STACK=daily,slack

# Deprecation warnings channel
LOG_DEPRECATIONS_CHANNEL=null

# Minimum log level - Use "error" for production
# Options: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=error


# ============================================
# DATABASE CONFIGURATION
# ============================================

# Database connection - Use PostgreSQL for production
# REQUIRED: pgsql for pgvector support
DB_CONNECTION=pgsql

# Database connection URL (alternative to individual params)
# Format: postgresql://user:password@host:port/database
# DB_URL=

# Database server hostname
# REQUIRED
DB_HOST=

# Database server port
DB_PORT=5432

# Database name
# REQUIRED
DB_DATABASE=

# Database username
# REQUIRED
DB_USERNAME=

# Database password
# REQUIRED: Use strong password (32+ characters)
# SECURITY: Never use default or weak passwords
DB_PASSWORD=

# Database character set
DB_CHARSET=utf8

# Database connection for cache
DB_CACHE_CONNECTION=pgsql
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks

# Database connection for queue
DB_QUEUE_CONNECTION=pgsql
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90


# ============================================
# NEO4J GRAPH DATABASE
# ============================================

# Enable Neo4j integration
NEO4J_ENABLED=true

# Neo4j connection type
NEO4J_CONNECTION=bolt

# Neo4j connection URI
# REQUIRED if NEO4J_ENABLED=true
NEO4J_URI=bolt://your-neo4j-host:7687

# Neo4j server hostname
# REQUIRED if NEO4J_ENABLED=true
NEO4J_HOST=

# Neo4j ports
NEO4J_PORT=7687
NEO4J_HTTP_PORT=7474

# Neo4j authentication
# REQUIRED if NEO4J_ENABLED=true
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j

# Neo4j password
# REQUIRED: Change from default, use strong password
# SECURITY: Never use default "neo4j" password
NEO4J_PASSWORD=

# Neo4j database name
NEO4J_DATABASE=neo4j

# Graph configuration
NEO4J_SIMILARITY_THRESHOLD=0.85
NEO4J_SYNC_BATCH_SIZE=100
NEO4J_AUTO_SYNC=true
NEO4J_AUTO_SYNC_ON_INGEST=true
NEO4J_UPDATE_RELATIONSHIPS=true


# ============================================
# OPENAI API
# ============================================

# OpenAI API key
# REQUIRED: Get from https://platform.openai.com/api-keys
# SECURITY: Restrict API key permissions
OPENAI_API_KEY=

# OpenAI organization and project (optional)
OPENAI_ORG=
OPENAI_PROJECT=

# OpenAI API endpoint
OPENAI_BASE_URL=https://api.openai.com/v1

# Model configuration - Optimize for cost/performance
OPENAI_RESPONSES_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# HTTP timeouts - Increase for production stability
OPENAI_TIMEOUT=120
OPENAI_CONNECT_TIMEOUT=30
OPENAI_RETRY_TIMES=3
OPENAI_RETRY_SLEEP_MS=500


# ============================================
# OTHER LLM PROVIDER API KEYS (Optional)
# ============================================

# Only set if using these providers
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# VOYAGEAI_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_NAME=


# ============================================
# AWS SERVICES
# ============================================

# AWS credentials
# REQUIRED for S3 and Textract
# SECURITY: Use IAM roles when running on AWS infrastructure
# SECURITY: Restrict IAM permissions to minimum required
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS region
# REQUIRED
AWS_DEFAULT_REGION=us-east-1

# S3 bucket name
# REQUIRED
AWS_BUCKET=

# S3 endpoint (optional, for S3-compatible services)
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# S3 prefixes for organization
S3_INPUT_PREFIX=textract/input
S3_OUTPUT_PREFIX=textract/output
S3_JSON_PREFIX=textract/json
S3_TABLES_PREFIX=textract/tables


# ============================================
# GOOGLE DRIVE INTEGRATION (Optional)
# ============================================

# Only set if using Google Drive
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_IMPERSONATE_USER=


# ============================================
# TEXTRACT OCR PROCESSING
# ============================================

TEXTRACT_AUTO_SYNC=true
TEXTRACT_EMBEDDING_MODEL=text-embedding-3-small
TEXTRACT_EMBEDDING_PROVIDER=openai
TEXTRACT_EMBEDDING_BATCH_SIZE=100
TEXTRACT_EMBEDDING_MAX_RETRIES=3
TEXTRACT_CHUNK_SIZE=1000
TEXTRACT_CHUNK_OVERLAP=200
TEXTRACT_QUEUE=textract
TEXTRACT_EMBEDDING_TIMEOUT=600
TEXTRACT_GRAPH_TIMEOUT=300
TEXTRACT_MIN_CONTENT_LENGTH=10
TEXTRACT_MAX_CONTENT_LENGTH=10000000
TEXTRACT_ALLOW_EMPTY_CONTENT=false
TEXTRACT_ENABLE_CONTENT_EDITING=true
TEXTRACT_ENABLE_MANUAL_SYNC=true
TEXTRACT_ENABLE_RESET_CONTENT=true
TEXTRACT_AUTO_EMBEDDINGS=true
TEXTRACT_AUTO_TABLES=true


# ============================================
# VIZRA ADK FRAMEWORK
# ============================================

VIZRA_ADK_ENABLED=true
VIZRA_ADK_LOGGING_ENABLED=true
VIZRA_ADK_LOGGING_LEVEL=warning
VIZRA_ADK_LOG_VECTOR_MEMORY=false
VIZRA_ADK_LOG_AGENTS=true
VIZRA_ADK_LOG_TOOLS=true
VIZRA_ADK_LOG_MCP=true
VIZRA_ADK_LOG_TRACES=false
VIZRA_ADK_DEFAULT_PROVIDER=openai
VIZRA_ADK_DEFAULT_MODEL=gpt-4o-mini
VIZRA_ADK_HTTP_TIMEOUT=120
VIZRA_ADK_HTTP_CONNECT_TIMEOUT=30
VIZRA_ADK_MAX_DELEGATION_DEPTH=5
VIZRA_ADK_TRACING_ENABLED=true
VIZRA_ADK_TRACING_CLEANUP_DAYS=30
VIZRA_ADK_WEB_ENABLED=true
VIZRA_ADK_DEFAULT_CHAT_AGENT=chat_agent
VIZRA_ADK_PROMPTS_USE_DATABASE=false
VIZRA_ADK_PROMPTS_CACHE_TTL=300
VIZRA_ADK_OCR_MIN_CONFIDENCE=0.82
VIZRA_ADK_OCR_MIN_COVERAGE=0.75
VIZRA_ADK_VECTOR_ENABLED=true
VIZRA_ADK_VECTOR_DRIVER=pgvector
VIZRA_ADK_EMBEDDING_PROVIDER=openai
VIZRA_ADK_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VIZRA_ADK_PGVECTOR_CONNECTION=pgsql
VIZRA_ADK_CHUNK_STRATEGY=sentence
VIZRA_ADK_CHUNK_SIZE=1000
VIZRA_ADK_CHUNK_OVERLAP=200
VIZRA_ADK_RAG_MAX_CONTEXT=4000
VIZRA_ADK_RAG_INCLUDE_METADATA=true


# ============================================
# AGENT FRAMEWORK
# ============================================

AGENT_MAX_ITERATIONS=15
AGENT_TIME_LIMIT=1800
AGENT_THRESHOLD=0.75
AGENT_SCHEDULE_CRON=weekly
AGENT_SCHEDULE_DAY=0
AGENT_SCHEDULE_TIME=02:00
AGENT_ASYNC_EXECUTION=true
AGENT_CACHE_ENABLED=true
AGENT_CACHE_TTL=3600
AGENT_QUEUE=agents
AGENT_LOG_LEVEL=info
AGENT_LOG_CHANNEL=stack
AGENT_LOG_ITERATIONS=false
AGENT_LOG_ACTIONS=false
AGENT_MAX_COST=10.00
AGENT_MAX_TIME=7200
AGENT_MAX_CONCURRENT=10
AGENT_REQUIRE_APPROVAL=false


# ============================================
# MCP (MODEL CONTEXT PROTOCOL)
# ============================================

# MCP API token
# REQUIRED: Generate secure random token (32+ characters)
# Example: openssl rand -hex 32
# SECURITY: Keep this secret
MCP_API_TOKEN=

# Rate limiting
MCP_RATE_LIMIT=120:1
MCP_AUTH_ENABLED=true
MCP_TOKEN_HEADER=X-MCP-Token
MCP_RATE_LIMIT_ENABLED=true
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_RATE_LIMIT_PER_HOUR=2000
MCP_RATE_LAW_SEARCH=30
MCP_RATE_LAW_GET=60
MCP_RATE_DECISION_SEARCH=30
MCP_RATE_DECISION_GET=60
MCP_RATE_CASE_SEARCH=20
MCP_MAX_PAGE_SIZE=100
MCP_DEFAULT_PAGE_SIZE=25
MCP_SIGNED_URL_EXPIRY=3600

# MCP Servers - Only enable what you need
MCP_NPX_PATH=npx
MCP_FILESYSTEM_ENABLED=false
MCP_GITHUB_ENABLED=false
MCP_POSTGRES_ENABLED=false
MCP_BRAVE_SEARCH_ENABLED=false
MCP_SLACK_ENABLED=false
MCP_ODLUKE_ENABLED=true
MCP_ODLUKE_TIMEOUT=45


# ============================================
# EXTERNAL APIS - CROATIAN COURT SYSTEMS
# ============================================

# EKOM (e-Komunikacija)
EKOM_BASE_URL=https://e-komunikacija.pravosudje.hr
EKOM_TOKEN=
EKOM_TIMEOUT=30
EKOM_RETRIES=3
EKOM_RETRY_DELAY_MS=500
EKOM_USER_AGENT=AI-Legal-War-Machine/1.0
EKOM_DEFAULT_PAGE_SIZE=50

# e-Oglasna (Court Notices)
E_OGLASNA_BASE_URL=https://e-oglasna.pravosudje.hr
E_OGLASNA_TIMEOUT=30
E_OGLASNA_CONNECT_TIMEOUT=10
E_OGLASNA_MIN_DELAY_MS=1100
E_OGLASNA_MAX_REQUESTS_PER_HOUR=950
E_OGLASNA_RETRY_JITTER_MS=100
E_OGLASNA_DEEP_SCAN_MAX_PAGES=500
E_OGLASNA_DEFAULT_SORT=datePublished,desc

# Odluke (Court Decisions)
ODLUKE_BASE_URL=https://odluke.sudovi.hr
ODLUKE_TIMEOUT=30
ODLUKE_RETRY=3
ODLUKE_DELAY_MS=700
ODLUKE_RPM=30
ODLUKE_BACKOFF_MS=800


# ============================================
# GRAPHQL CLIENT (Optional)
# ============================================

# Only set if using GraphQL
# GRAPHQL_ENDPOINT=
# GRAPHQL_AUTH_HEADER=Authorization
# GRAPHQL_TOKEN=
# GRAPHQL_CACHE_STORE=redis
# GRAPHQL_AUTO_DISCOVER=true


# ============================================
# CACHE CONFIGURATION
# ============================================

# Cache driver - Use Redis for production
# REQUIRED: redis for production performance
CACHE_STORE=redis
CACHE_PREFIX=legal_cache_

# Redis cache connections (uses REDIS_CACHE_DB=0 from Redis config)
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default


# ============================================
# QUEUE CONFIGURATION
# ============================================

# Queue driver - Use Redis for production
# REQUIRED: redis for production performance
QUEUE_CONNECTION=redis
QUEUE_PREFIX=legal_queues_
QUEUE_FAILED_DRIVER=database-uuids

# Redis queue configuration (uses REDIS_QUEUE_DB=2 from Redis config)
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90


# ============================================
# DISTRIBUTED PROCESSING
# ============================================

DISTRIBUTED_SCALING_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small


# ============================================
# REDIS CONFIGURATION
# ============================================

# Redis client
REDIS_CLIENT=phpredis

# Redis connection
# REQUIRED
REDIS_HOST=127.0.0.1

# Redis password
# REQUIRED: Use strong password (generate with: openssl rand -base64 32)
# SECURITY: Never leave empty in production
REDIS_PASSWORD=

# Redis port
REDIS_PORT=6379

# Redis databases - Separate databases for different purposes
# Database 0: Default/Cache
# Database 1: Sessions
# Database 2: Queues
# Database 3: Broadcasting
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=2
REDIS_BROADCAST_DB=3

# Redis advanced configuration
REDIS_CLUSTER=redis
REDIS_PREFIX=legal_
REDIS_PERSISTENT=true
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000


# ============================================
# MAIL CONFIGURATION
# ============================================

# Mail driver - Use SMTP or service for production
# Options: smtp, ses, mailgun, postmark, sendmail
MAIL_MAILER=smtp

# SMTP configuration
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587

# SMTP credentials
# REQUIRED if using SMTP
MAIL_USERNAME=
MAIL_PASSWORD=

# From address
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Service-specific tokens (if not using SMTP)
# POSTMARK_TOKEN=
# RESEND_KEY=


# ============================================
# SESSION & BROADCASTING
# ============================================

# Session driver - Use Redis for production
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Broadcasting driver (uses REDIS_BROADCAST_DB=3 from Redis config)
BROADCAST_CONNECTION=redis
BROADCAST_REDIS_CONNECTION=broadcast

# Filesystem disk - Use S3 for production
FILESYSTEM_DISK=s3


# ============================================
# MEMCACHED CONFIGURATION (Optional)
# ============================================

# Only set if using Memcached
# MEMCACHED_HOST=
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=


# ============================================
# MEILISEARCH CONFIGURATION (Optional)
# ============================================

# Only set if using Meilisearch
# MEILISEARCH_HOST=
# MEILISEARCH_KEY=
# MEILISEARCH_PREFIX=legal_vectors_
# MEILISEARCH_EMBEDDER=default
# MEILISEARCH_SEMANTIC_RATIO=1.0


# ============================================
# SLACK INTEGRATION (Optional)
# ============================================

# Slack notifications for errors and alerts
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=#alerts


# ============================================
# THIRD-PARTY SERVICES (Optional)
# ============================================

# Only set if using these services
# POSTMARK_TOKEN=
# RESEND_KEY=


# ============================================
# SECURITY CHECKLIST
# ============================================
#
# Before deploying to production, verify:
#
# [ ] APP_DEBUG=false
# [ ] APP_ENV=production
# [ ] APP_KEY is set (generated)
# [ ] APP_URL uses HTTPS
# [ ] LOG_LEVEL=error or warning
# [ ] All database passwords are strong and unique
# [ ] Neo4j password changed from default
# [ ] Redis password is set
# [ ] MCP_API_TOKEN is generated and secure
# [ ] All API keys are set (OpenAI, AWS, etc.)
# [ ] SESSION_SECURE_COOKIE=true
# [ ] SESSION_ENCRYPT=true
# [ ] QUEUE_CONNECTION=redis
# [ ] CACHE_STORE=redis
# [ ] Mail configuration is set
# [ ] Backup strategy is in place
# [ ] Monitoring and alerting configured
# [ ] SSL/TLS certificates installed
# [ ] Firewall rules configured
# [ ] Rate limiting enabled
# [ ] CORS configured properly
# [ ] File upload limits set
# [ ] Error pages customized
# [ ] Maintenance mode tested
#
# ============================================
