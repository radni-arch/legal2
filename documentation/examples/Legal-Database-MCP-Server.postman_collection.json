            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"otkaz ugovora o radu\",\n  \"tags\": \"labor\",\n  \"date_from\": \"2020-01-01\",\n  \"limit\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mcp/decision.search",
