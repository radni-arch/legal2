              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"otkaz ugovora o radu\",\n  \"country\": \"HR\",\n  \"tags\": \"labor\",\n  \"limit\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mcp/law.search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mcp", "law.search"]
            },
            "description": "Step 1: Find relevant laws"
          }
        },
        {
          "name": "2. Research Labor Law - Search Decisions",
          "request": {
            "method": "POST",
