                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": \"01HQZZZ123456789\",\n  \"query\": \"ugovor o radu\",\n  \"search_documents\": true,\n  \"include_content\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mcp/case.search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mcp", "case.search"]
            },
            "description": "Search within case documents"
          }
        },
        {
          "name": "Get All Case Documents",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": \"01HQZZZ123456789\",\n  \"search_documents\": true,\n  \"limit\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mcp/case.search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mcp", "case.search"]
            },
            "description": "Retrieve all documents for a case"
          }
        }
      ]
    },
    {
      "name": "Workflow Examples",
      "item": [
        {
          "name": "1. Research Labor Law - Search Laws",
          "request": {
            "method": "POST",
            "header": [
              {
