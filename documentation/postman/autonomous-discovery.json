{
	"info": {
		"_postman_id": "autonomous-discovery-collection-2025",
		"name": "Autonomous Decision Discovery API",
		"description": "Complete API collection for testing autonomous decision discovery workflows.\n\n**Authentication:** All requests require X-MCP-Token header.\n\n**Base URL:** Update the {{base_url}} variable to match your environment.\n\n**Setup:**\n1. Import this collection into Postman\n2. Set environment variables:\n   - base_url: https://your-domain.com\n   - mcp_token: your-api-token\n3. Run the test suite\n\n**Collection Structure:**\n- Authentication Tests\n- Decision Search API\n- Decision Retrieval API\n- Discovery Management API\n- Graph Integration API\n- Sample Workflows\n\n**Version:** 1.0\n**Last Updated:** 2025-01-29",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "value",
				"value": "{{mcp_token}}",
				"type": "string"
			},
			{
				"key": "key",
				"value": "X-MCP-Token",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://your-domain.com",
			"type": "string"
		},
		{
			"key": "mcp_token",
			"value": "your-api-token-here",
			"type": "string"
		},
		{
			"key": "decision_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "run_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Test API Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 or 401\", function () {",
									"    pm.expect([200, 401]).to.include(pm.response.code);",
									"});",
									"",
									"if (pm.response.code === 401) {",
									"    pm.test(\"Invalid token message\", function () {",
									"        pm.expect(pm.response.json()).to.have.property('message');",
									"    });",
									"}",
									"",
									"if (pm.response.code === 200) {",
									"    pm.test(\"Token is valid\", function () {",
									"        pm.expect(pm.response.json()).to.have.property('success', true);",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"query\": \"test\",\n    \"limit\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/mcp/decision.search",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"mcp",
								"decision.search"
							]
						},
						"description": "Test if your API token is valid by making a simple search request."
					},
					"response": []
				}
			],
			"description": "Authentication and token validation tests."
		},
		{
			"name": "2. Decision Search",
			"item": [
				{
					"name": "Search by Query",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success property\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success', true);",
									"});",
									"",
									"pm.test(\"Response has data array\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('decisions');",
									"    pm.expect(jsonData.data.decisions).to.be.an('array');",
									"});",
									"",
									"// Save first decision ID for next request",
									"var jsonData = pm.response.json();",
									"if (jsonData.data.decisions.length > 0) {",
									"    pm.collectionVariables.set('decision_id', jsonData.data.decisions[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"query\": \"nezakonit otkaz\",\n    \"limit\": 20,\n    \"offset\": 0\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/mcp/decision.search",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"mcp",
								"decision.search"
							]
						},
						"description": "Search court decisions by keyword query."
					},
					"response": []
				},
				{
					"name": "Search with Filters",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Results match court filter\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data.decisions.length > 0) {",
									"        jsonData.data.decisions.forEach(function(decision) {",
									"            pm.expect(decision.court).to.include('Vrhovni');",
									"        });",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"query\": \"ugovorna odgovornost\",\n    \"limit\": 10,\n    \"filters\": {\n        \"court\": \"Vrhovni sud\",\n        \"dateFrom\": \"2024-01-01\",\n        \"dateTo\": \"2025-01-29\",\n        \"type\": \"Presuda\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/mcp/decision.search",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"mcp",
								"decision.search"
							]
						},
						"description": "Search with court, date, and type filters."
					},
					"response": []
				},
				{
					"name": "Search by Topic",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"query\": \"potrošačka zaštita\",\n    \"limit\": 15\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/mcp/decision.search",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"mcp",
								"decision.search"
							]
						},
						"description": "Search for consumer protection decisions."
					},
					"response": []
				},
				{
					"name": "Pagination Example",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"query\": \"vlasničkopravni spor\",\n    \"limit\": 20,\n    \"offset\": 20\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/mcp/decision.search",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"mcp",
								"decision.search"
							]
						},
						"description": "Get page 2 of results (offset = 20, limit = 20)."
					},
					"response": []
				}
			],
			"description": "Court decision search endpoints with various query options."
		},
		{
			"name": "3. Decision Details",
			"item": [
				{
					"name": "Get Decision by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has decision data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success', true);",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.expect(jsonData.data).to.have.property('title');",
									"    pm.expect(jsonData.data).to.have.property('court');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": \"{{decision_id}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/mcp/decision.get",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
