{
  "dashboard": {
    "title": "AI Legal War Machine - Agent Deep Dive",
    "description": "Per-agent performance, reasoning traces, confidence scores, active learning",
    "tags": ["ai-legal", "agents", "performance"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "1m",
    "templating": {
      "list": [
        {
          "name": "agent_type",
          "type": "query",
          "query": "label_values(agent_success_total, agent_type)",
          "multi": true,
          "includeAll": true
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Agent Success Rate by Type",
        "type": "timeseries",
        "targets": [
          {
            "expr": "(rate(agent_success_total{agent_type=~\"$agent_type\"}[5m]) / (rate(agent_success_total{agent_type=~\"$agent_type\"}[5m]) + rate(agent_failure_total{agent_type=~\"$agent_type\"}[5m]))) * 100",
            "legendFormat": "{{agent_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Agent Duration Distribution",
        "type": "heatmap",
        "targets": [
          {
            "expr": "sum(rate(agent_duration_seconds_bucket{agent_type=~\"$agent_type\"}[5m])) by (le, agent_type)",
            "format": "heatmap"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Reasoning Trace Depth",
        "type": "histogram",
        "targets": [
          {
            "expr": "reasoning_trace_depth{agent_type=~\"$agent_type\"}",
            "legendFormat": "{{agent_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "levels"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Confidence Score Distribution",
        "type": "histogram",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(agent_confidence_score_bucket[5m]))",
            "legendFormat": "p50 - {{agent_type}}"
          },
          {
            "expr": "histogram_quantile(0.95, rate(agent_confidence_score_bucket[5m]))",
            "legendFormat": "p95 - {{agent_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Learning Opportunities Flagged",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(learning_opportunities_flagged_total[5m])",
            "legendFormat": "{{opportunity_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Agent Errors by Type",
        "type": "table",
        "targets": [
          {
            "expr": "sum by (agent_type, error_type) (increase(agent_failure_total[1h]))",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      }
    ]
  }
}
