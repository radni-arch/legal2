{
    "template_key": "legal-constitutional",
    "name": "Ustavni sud format",
    "court_types": ["ustavni_sud"],
    "formatting": {
        "font_family": "Times New Roman",
        "font_size": 12,
        "margin_top_cm": 3.0,
        "margin_bottom_cm": 3.0,
        "margin_left_cm": 3.0,
        "margin_right_cm": 2.5,
        "line_spacing": 1.5,
        "heading_bold": true,
        "heading_size": 14,
        "paragraph_indent_cm": 1.25
    },
    "header": {
        "include_sender": true,
        "include_date": true,
        "include_case_number": true,
        "include_constitutional_reference": true,
        "date_format": "d. MMMM yyyy."
    },
    "footer": {
        "include_page_number": true,
        "include_signature_line": true,
        "include_constitutional_articles": true
    }
}
