{
    "template_key": "echr-application",
    "name": "ECHR Application Format",
    "court_types": ["echr"],
    "formatting": {
        "font_family": "Arial",
        "font_size": 11,
        "margin_top_cm": 2.5,
        "margin_bottom_cm": 2.5,
        "margin_left_cm": 2.5,
        "margin_right_cm": 2.5,
        "line_spacing": 1.15,
        "heading_bold": true,
        "heading_size": 13,
        "paragraph_indent_cm": 0
    },
    "header": {
        "include_sender": true,
        "include_date": true,
        "include_application_number": true,
        "language": "en",
        "date_format": "d MMMM Y"
    },
    "footer": {
        "include_page_number": true,
        "include_signature_line": true
    }
}
